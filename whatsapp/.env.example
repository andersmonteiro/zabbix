PORT=8765

# Gerado automaticamente pelo install.sh — único por cliente
WEBHOOK_TOKEN=

# Preenchido manualmente após escanear o QR Code (ver README)
GROUP_IDS=

ZABBIX_URL=http://host.docker.internal:8080
ZABBIX_USER=Admin
ZABBIX_PASS=Natverk-Noc-2026!

# URL que o Zabbix usa para alcançar ESTE serviço (webhook do media type
# "WhatsApp Webhook", importado automaticamente pelo install.sh). O
# 172.17.0.1 é o gateway padrão da rede bridge do Docker — alcançável a
# partir de qualquer container no mesmo host em instalações padrão. Só
# ajuste se a topologia de rede do host divergir disso.
ZABBIX_WEBHOOK_URL=http://172.17.0.1:8765/webhook

CHART_PERIOD=3600
CHART_WIDTH=900
CHART_HEIGHT=200
ZABBIX_INSECURE=0

# ── IA (responder mensagens do WhatsApp usando o agente central) ─────────────
# URL do endpoint de chat do agente central (não mexer, a menos que mude)
AI_AGENT_URL=https://agent.natverk.com.br/chat

# Token de um cliente cadastrado em agent.natverk.com.br/admin/clients
# (crie um cliente com nome "whatsapp" lá, copie o token gerado e cole aqui).
# Vazio = IA desligada, o bot só continua enviando alertas do Zabbix.
AI_AGENT_TOKEN=

# IDs dos chats/grupos que a IA deve responder (descubra com GET /groups
# para grupos, ou o próprio número com @c.us para DM). Vazio = responde
# qualquer DM e qualquer grupo em que for mencionado.
AI_ALLOWED_CHATS=

# Timeout (ms) esperando a resposta do agente antes de desistir
AI_REQUEST_TIMEOUT_MS=60000
