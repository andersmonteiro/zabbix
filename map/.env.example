# Preenchidos automaticamente pelo install.sh a partir de stack/.env
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=zabbix

# Preenchido automaticamente pelo install.sh a partir de stack/.env
ZABBIX_URL=http://zabbix-frontend:8080
ZABBIX_USER=Admin
ZABBIX_PASS=

# Segundos entre atualizações do cache de status do Zabbix
POLL_INTERVAL_SECONDS=30

# Segundos sem atualização bem-sucedida antes de marcar tudo como 'unknown'
STALE_THRESHOLD_SECONDS=120

# Provedor de tile do mapa: "osm" (padrão, grátis) ou "mapbox"
TILE_PROVIDER=osm
# Só necessário se TILE_PROVIDER=mapbox
MAPBOX_TOKEN=

# Chave usada para assinar o cookie de sessão do login — gerada pelo
# install.sh na primeira instalação (openssl rand -hex 32)
MAP_SECRET_KEY=

# Usuário administrador criado automaticamente na primeira subida, se ainda
# não existir nenhum usuário cadastrado. Preenchido pelo install.sh a partir
# de stack/.env (mesma senha padrão do Zabbix/Grafana).
MAP_ADMIN_USER=admin
MAP_ADMIN_PASSWORD=
